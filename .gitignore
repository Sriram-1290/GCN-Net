# Raw and cached data — 3.4 GB, reproducible from the PhysioNet archive
data/raw/
# every cache variant, not just the default one -- an ablation config gets its
# own cache dir (data/cache_bp830, ...) and those are payload too
data/cache*/
physionet.org/
*.zip

# Experiment outputs
checkpoints/
runs/
outputs/

# ...but the experiment log is a result, not an output. CLAUDE.md requires one
# persistent row per run; versioning it makes the reported numbers auditable.
!runs/
runs/*
!runs/experiments.jsonl
*.pt
*.pth
*.npy
*.h5
*.hdf5

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
